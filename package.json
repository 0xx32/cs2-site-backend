  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@types/node": "^20.19.24",
    "eslint": "^9.38.0",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-perfectionist": "^4.15.1",
