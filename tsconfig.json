{
	"compilerOptions": {
		"target": "ESNext",
		"baseUrl": ".",
		"rootDir": ".",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@database/*": ["./database/*"]
		},
		"strict": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["src", "scripts"]
}
